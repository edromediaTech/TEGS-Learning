  "physics": {
    "engine": "custom_dc",
    "variables": {
      "wind_speed": "wind_control.wind_speed_kmh",
      "max_speed_threshold": "rotor_assembly.max_wind_speed_kmh",
      "rotation_speed_formula": "wind_speed * 0.1"
    },
    "friction_coefficient": 0.05,
    "gravity": [
      0.0,
      -9.81,
      0.0
    ]
  },
  "events": [
    {
      "id": "evt_rotor_spin",
      "trigger": "wind_control.wind_speed_kmh > 0 AND wind_control.wind_speed_kmh <= rotor_assembly.max_wind_speed_kmh",
      "action": "set_rotation",
      "target": "rotor_assembly",
      "params": {
        "axis": [
          1,
          0,
          0
        ],
        "speed_formula": "wind_control.wind_speed_kmh * 0.1"
      },
      "xapi_verb": "interacted",
      "xapi_description": "L'éolienne tourne normalement sous l'effet du vent."
    },
    {
      "id": "evt_blades_break",
      "trigger": "wind_control.wind_speed_kmh > rotor_assembly.max_wind_speed_kmh",
      "action": "explode",
      "target": "rotor_assembly",
      "params": {
        "fragments": 30,
        "force": 8.0
      },
      "xapi_verb": "failed",
      "xapi_description": "Les pales se brisent, la vitesse du vent a dépassé le seuil de tolérance."
    },
    {
      "id": "evt_rotor_stop",
      "trigger": "wind_control.wind_speed_kmh == 0",
      "action": "set_rotation",
      "target": "rotor_assembly",
      "params": {
        "axis": [
          1,
          0,
          0
        ],
        "speed_formula": "0"
      },
      "xapi_verb": "experienced",
      "xapi_description": "L'éolienne est à l'arrêt, faute de vent."
    }
  ],
  "scoring": {
    "success_criteria": "evt_rotor_spin triggered for 15 seconds without triggering evt_blades_break",
    "max_score": 100,
    "penalty_per_explosion": 100
  },
