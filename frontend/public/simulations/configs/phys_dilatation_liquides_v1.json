  "physics": {
    "engine": "custom_thermal",
    "variables": {
      "temperature": "hot_plate.temperature_celsius",
      "boiling_point": 95.0,
      "initial_temp": 20.0,
      "expansion_factor": 0.015
    },
    "friction_coefficient": 0.1,
    "gravity": [
      0.0,
      -9.81,
      0.0
    ]
  },
  "events": [
    {
      "id": "evt_show_temp",
      "trigger": "temperature >= initial_temp",
      "action": "set_display_text",
      "target": "temp_display",
      "params": {
        "value_from": "temperature",
        "unit": "°C",
        "label": "T =",
        "precision": 1,
        "color": "#FFD700",
        "background": "#05050A"
      },
      "xapi_verb": "experienced",
      "xapi_description": "Affiche la température de l'eau."
    },
    {
      "id": "evt_alcohol_expand",
      "trigger": "temperature > initial_temp",
      "action": "animate_scale",
      "target": "alcohol_column",
      "params": {
        "axis": [
          0,
          1,
          0
        ],
        "formula": "0.4 + (temperature - initial_temp) * expansion_factor"
      },
      "xapi_verb": "experienced",
      "xapi_description": "La colonne d'alcool se dilate avec la chaleur."
    },
    {
      "id": "evt_alcohol_color",
      "trigger": "temperature > initial_temp",
      "action": "tint_color",
      "target": "alcohol_column",
      "params": {
        "start_color": [
          1.0,
          0.4,
          0.4
        ],
        "end_color": [
          1.0,
          0.0,
          0.0
        ],
        "value_map": "temperature",
        "min_value": 20.0,
        "max_value": 95.0
      },
      "xapi_verb": "experienced",
      "xapi_description": "La couleur de l'alcool s'intensifie."
    },
    {
      "id": "evt_water_boil",
      "trigger": "temperature > boiling_point",
      "action": "emit_particles",
      "target": "water",
      "params": {
        "type": "smoke",
        "rate": 50,
        "lifespan": 3.0,
        "speed": 0.2
      },
      "xapi_verb": "passed",
      "xapi_description": "L'eau atteint son point d'ébullition et de la vapeur se forme."
    },
    {
      "id": "evt_plate_glow",
      "trigger": "temperature > 30",
      "action": "set_emission",
      "target": "hot_plate",
      "params": {
        "intensity_formula": "(temperature - 30) / 80",
        "color": [
          1.0,
          0.2,
          0.0
        ]
      },
      "xapi_verb": "experienced",
      "xapi_description": "La plaque chauffante devient incandescente."
    }
  ],
  "scoring": {
    "success_criteria": "evt_water_boil triggered",
