        "color": "#FFFFFF",
        "background": "#000000"
      },
      "xapi_verb": "experienced",
      "xapi_description": "L'élève mesure la tension d'une seule pile (1.5V)."
    },
    {
      "id": "evt_measure_inverted",
      "trigger": "voltmeter.target_config == 'single' AND voltmeter.probes_inverted == true",
      "action": "set_display_text",
