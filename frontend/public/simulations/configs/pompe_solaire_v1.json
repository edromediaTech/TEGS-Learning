  "physics": {
    "engine": "custom_power_system",
    "variables": {
      "light_intensity": "soleil.intensity",
      "panel_output_power": "panneau_solaire.max_power_watts * light_intensity",
      "pump_power_requirement": "pompe.required_watts"
    },
    "friction_coefficient": 0.1,
    "gravity": [
      0.0,
      0.0,
      -9.81
    ]
  },
  "events": [
    {
      "id": "evt_pompe_on",
      "trigger": "panel_output_power >= pump_power_requirement",
      "action": "set_property",
      "target": "jet_eau",
      "params": {
        "visible": true
      },
      "xapi_verb": "experienced",
      "xapi_description": "La pompe s'active car l'ensoleillement est suffisant."
    },
    {
      "id": "evt_pompe_off",
      "trigger": "panel_output_power < pump_power_requirement",
      "action": "set_property",
      "target": "jet_eau",
      "params": {
        "visible": false
      },
      "xapi_verb": "experienced",
      "xapi_description": "La pompe s'arrête car l'ensoleillement est insuffisant (crépuscule)."
    },
    {
      "id": "evt_ajustement_lumiere",
      "trigger": "on_property_change(soleil.intensity)",
      "action": "log",
      "target": "soleil",
      "params": {},
      "xapi_verb": "interacted",
      "xapi_description": "L'utilisateur a modifié la luminosité pour simuler le cycle jour/nuit."
    }
  ],
  "scoring": {
    "success_criteria": "evt_pompe_on triggered AND evt_pompe_off triggered",
    "max_score": 100
  },
  "export": {
    "format": "glb",
    "filename": "pompe_solaire_v1.glb",
