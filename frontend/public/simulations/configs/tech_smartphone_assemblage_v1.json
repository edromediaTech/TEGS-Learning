  "assembly": {
    "hide_at_start": [
      "battery",
      "charge_connector",
      "vibrator",
      "speaker",
      "pmic",
      "cpu",
      "camera",
      "screen"
    ],
    "steps": [
      {
        "order": 1,
        "asset_id": "battery",
        "label": "Inserer la batterie Li-ion dans son logement",
        "rationale": "La batterie se monte en premier car elle se connecte ensuite au PCB via une nappe.",
        "tools": [
          "spudger plastique"
        ]
      },
      {
        "order": 2,
        "asset_id": "charge_connector",
        "label": "Visser la nappe du connecteur de charge USB-C",
        "rationale": "Connecteur secondaire mais souvent enclave, doit etre installe avant les modules superieurs.",
        "tools": [
          "tournevis Phillips 1.5mm"
        ]
      },
      {
        "order": 3,
        "asset_id": "vibrator",
        "label": "Coller le moteur du vibreur",
        "rationale": "Petit module a placer tot pour eviter de tout demonter pour y acceder plus tard.",
        "tools": [
          "adhesif pre-coupe"
        ]
      },
      {
        "order": 4,
        "asset_id": "speaker",
        "label": "Visser le haut-parleur",
        "rationale": "Module de la partie haute, monte avant les puces principales.",
        "tools": [
          "tournevis Phillips 1.5mm"
        ]
      },
      {
        "order": 5,
        "asset_id": "pmic",
        "label": "Souder/positionner la puce de gestion d'energie (PMIC)",
        "rationale": "Le PMIC alimente la carte mere donc doit etre operationnel avant le CPU.",
        "tools": [
          "station de soudure 350C"
        ]
      },
      {
        "order": 6,
        "asset_id": "cpu",
        "label": "Positionner le processeur (CPU) sur la carte mere",
        "rationale": "Le CPU vient apres le PMIC car il consomme l'energie qu'il delivre.",
        "tools": [
          "pate thermique",
          "station de soudure"
        ]
      },
      {
        "order": 7,
        "asset_id": "camera",
        "label": "Brancher le module camera arriere",
        "rationale": "Module branche tardivement car sa nappe passe au-dessus des autres.",
        "tools": [
          "spudger plastique"
        ]
      },
      {
        "order": 8,
        "asset_id": "screen",
        "label": "Poser l'ecran AMOLED et connecter sa nappe tactile",
        "rationale": "L'ecran est TOUJOURS le dernier element, il scelle l'appareil et tout test final passe par lui.",
        "tools": [
          "adhesif perimetrique",
          "ventouse de positionnement"
        ]
      }
    ]
  },
