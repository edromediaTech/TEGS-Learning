  "physics": {
    "engine": "custom_dc",
    "variables": {
      "voltage_source": "power_source.voltage",
      "resistance": "potentiometer.resistance_ohm",
      "current_formula": "voltage_source / resistance",
      "max_current_threshold": "led.max_current"
    },
    "friction_coefficient": 0.1,
    "gravity": [
      0.0,
      0.0,
      -9.81
    ]
  },
  "events": [
    {
      "id": "evt_update_led_brightness",
      "trigger": "current > 0 AND current <= led.max_current",
      "action": "set_emission",
      "target": "led",
      "params": {
        "intensity_formula": "current / led.max_current * 5.0",
        "color": [
          1.0,
          0.2,
          0.2
        ]
      },
      "xapi_verb": "experienced",
      "xapi_description": "La luminosité de la LED varie avec le courant."
    },
    {
      "id": "evt_led_burnout",
      "trigger": "current > led.max_current",
      "action": "set_color",
      "target": "led",
      "params": {
        "color": [
          0.1,
          0.1,
          0.1
        ]
      },
      "xapi_verb": "failed",
      "xapi_description": "La LED a grillé. La résistance est trop faible, le courant est trop élevé."
    },
    {
      "id": "evt_led_off_burnt",
      "trigger": "current > led.max_current",
      "action": "set_emission",
      "target": "led",
      "params": {
        "intensity": 0.0
      },
      "xapi_verb": "terminated",
      "xapi_description": "La LED est grillée et ne s'allume plus."
    },
    {
      "id": "evt_show_voltage",
      "trigger": "true",
      "action": "set_display_text",
      "target": "power_source",
      "params": {
        "value_formula": "power_source.voltage",
        "unit": "V",
        "label": "U =",
        "precision": 1,
        "color": "#7CFC00",
        "background": "#0b0f14"
      },
      "xapi_verb": "experienced",
      "xapi_description": "Affiche la tension de la source."
    },
    {
      "id": "evt_show_resistance",
      "trigger": "true",
      "action": "set_display_text",
      "target": "potentiometer",
      "params": {
        "value_formula": "potentiometer.resistance_ohm",
        "unit": "Ω",
        "label": "R =",
        "precision": 0,
        "color": "#FFA500",
        "background": "#0b0f14"
      },
      "xapi_verb": "experienced",
      "xapi_description": "Affiche la valeur de la résistance ajustée."
    },
    {
      "id": "evt_show_current",
      "trigger": "true",
      "action": "set_display_text",
      "target": "led",
      "params": {
        "value_formula": "current * 1000",
        "unit": "mA",
        "label": "I =",
        "precision": 2,
        "color": "#1E90FF",
        "background": "#0b0f14"
      },
      "xapi_verb": "experienced",
      "xapi_description": "Affiche l'intensité calculée dans le circuit."
    }
  ],
  "scoring": {
    "success_criteria": "experienced evt_update_led_brightness AND NOT triggered evt_led_burnout",
