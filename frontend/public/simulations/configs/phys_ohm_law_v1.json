  "events": [
    {
      "id": "evt_bulb_on",
      "trigger": "current > 0 AND voltage_source <= bulb.max_voltage",
      "action": "set_emission",
      "target": "bulb",
      "params": {
        "intensity": 5.0,
        "color": [
          1.0,
          0.95,
          0.6
        ]
      },
      "xapi_verb": "experienced",
      "xapi_description": "L'ampoule s'allume normalement"
    },
    {
      "id": "evt_bulb_explode",
      "trigger": "voltage_source > bulb.max_voltage",
      "action": "explode",
      "target": "bulb",
      "params": {
        "fragments": 12,
        "force": 4.0
      },
      "xapi_verb": "failed",
      "xapi_description": "L'ampoule explose - tension excessive"
    },
    {
      "id": "evt_circuit_open",
      "trigger": "current == 0",
      "action": "set_emission",
      "target": "bulb",
      "params": {
        "intensity": 0.0
      },
      "xapi_verb": "experienced",
      "xapi_description": "Circuit ouvert - aucun courant"
    },
    {
      "id": "evt_show_voltage",
      "trigger": "battery.voltage > 0",
      "action": "set_display_text",
      "target": "battery",
      "params": {
        "value": 9.0,
        "unit": "V",
        "label": "U =",
        "precision": 1,
        "color": "#7CFC00",
        "background": "#0b0f14"
      },
      "xapi_verb": "experienced",
      "xapi_description": "Affiche la tension lue sur la pile"
    },
    {
      "id": "evt_show_current",
      "trigger": "current > 0",
      "action": "set_display_text",
      "target": "battery",
      "params": {
        "value": 1.8,
        "unit": "A",
        "label": "I =",
        "precision": 2,
        "color": "#ffd24a",
        "background": "#0b0f14"
      },
      "xapi_verb": "experienced",
      "xapi_description": "Affiche l'intensite calculee dans le circuit"
    }
  ],
  "scoring": {
