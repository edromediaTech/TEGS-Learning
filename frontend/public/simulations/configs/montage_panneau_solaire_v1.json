  "physics": {
    "engine": "custom_dc",
    "variables": {
      "is_series": "connection(terminal_p1_plus, terminal_p2_minus)",
      "is_parallel": "connection(terminal_p1_plus, terminal_p2_plus) AND connection(terminal_p1_minus, terminal_p2_minus)",
      "is_polarity_error": "connection(terminal_p1_plus, terminal_p1_minus) OR connection(terminal_p2_plus, terminal_p2_minus)",
      "voltage_in": "is_series ? (panel_1.voltage + panel_2.voltage) : (is_parallel ? panel_1.voltage : 0)",
      "current_in": "is_series ? panel_1.current : (is_parallel ? (panel_1.current + panel_2.current) : 0)",
      "is_charging": "voltage_in > battery.voltage AND regulator.is_damaged == 0"
    },
    "friction_coefficient": 0.1,
    "gravity": [
      0.0,
      0.0,
      -9.81
    ]
  },
  "events": [
    {
      "id": "evt_show_series_values",
      "trigger": "is_series == true AND regulator.is_damaged == 0",
      "action": "set_display_text",
      "target": "regulator",
      "params": {
        "value": 24.0,
        "unit": "V",
        "label": "U (série) =",
        "precision": 1,
        "color": "#7CFC00"
      },
      "xapi_verb": "experienced",
      "xapi_description": "L'élève a correctement monté les panneaux en série, observant l'addition des tensions."
    },
    {
      "id": "evt_show_parallel_values",
      "trigger": "is_parallel == true AND regulator.is_damaged == 0",
      "action": "set_display_text",
      "target": "regulator",
      "params": {
        "value": 10.0,
        "unit": "A",
        "label": "I (parallèle) =",
        "precision": 1,
        "color": "#ffd24a"
      },
      "xapi_verb": "experienced",
      "xapi_description": "L'élève a correctement monté les panneaux en parallèle, observant l'addition des courants."
    },
    {
      "id": "evt_polarity_error_damage",
      "trigger": "is_polarity_error == true AND regulator.is_damaged == 0",
      "action": "set_property",
      "target": "regulator",
      "params": {
        "property": "is_damaged",
        "value": 1
      },
      "xapi_verb": "failed",
      "xapi_description": "Erreur critique : L'élève a créé un court-circuit en inversant les polarités, endommageant le régulateur."
    },
    {
      "id": "evt_show_damage_effect",
      "trigger": "regulator.is_damaged == 1",
      "action": "explode",
      "target": "regulator",
      "params": {
        "fragments": 5,
        "force": 0.5,
        "effect": "smoke"
      },
      "xapi_verb": "experienced",
      "xapi_description": "Visualisation des dégâts sur le régulateur suite à l'inversion de polarité."
    },
    {
      "id": "evt_battery_charging",
      "trigger": "is_charging == true",
      "action": "set_emission",
      "target": "battery",
      "params": {
        "intensity": 2.0,
        "color": [
          0.2,
          1.0,
          0.2
        ]
      },
      "xapi_verb": "passed",
      "xapi_description": "Le système est fonctionnel et la batterie est en cours de charge."
    },
    {
      "id": "evt_stop_charging",
      "trigger": "is_charging == false",
      "action": "set_emission",
      "target": "battery",
      "params": {
        "intensity": 0.0
      },
      "xapi_verb": "experienced",
      "xapi_description": "Le circuit est ouvert ou incorrect, la charge de la batterie est arrêtée."
    }
  ],
  "scoring": {
    "success_criteria": "evt_battery_charging triggered for 10 seconds",
    "max_score": 100,
    "penalty_per_polarity_error": 75
  },
