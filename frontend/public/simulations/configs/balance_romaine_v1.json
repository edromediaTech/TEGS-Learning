  "physics": {
    "engine": "custom_torque",
    "variables": {
      "g": 9.81,
      "mass_R": "sac_pwa.mass_kg",
      "dist_R": 0.1,
      "torque_R": "mass_R * g * dist_R",
      "mass_F": "pilon.mass_kg",
      "dist_F": "pilon.position.x",
      "torque_F": "mass_F * g * dist_F",
      "net_torque": "torque_F - torque_R",
      "equilibrium_pos": "(mass_R * dist_R) / mass_F"
    },
    "gravity": [
      0.0,
      0.0,
      -9.81
    ]
  },
  "events": [
    {
      "id": "evt_tilt_resistance",
      "trigger": "net_torque < -0.1",
      "action": "rotate_to",
      "target": "fleau",
      "params": {
        "rotation_z_deg": -8.0,
        "duration_s": 0.5
      },
      "xapi_verb": "experienced",
      "xapi_description": "Déséquilibre : le moment de la résistance est supérieur."
    },
    {
      "id": "evt_tilt_force",
      "trigger": "net_torque > 0.1",
      "action": "rotate_to",
      "target": "fleau",
      "params": {
        "rotation_z_deg": 8.0,
        "duration_s": 0.5
      },
      "xapi_verb": "experienced",
      "xapi_description": "Déséquilibre : le moment de la force (pilon) est supérieur."
    },
    {
      "id": "evt_equilibrium_reached",
      "trigger": "abs(net_torque) <= 0.1",
      "action": "rotate_to",
      "target": "fleau",
      "params": {
        "rotation_z_deg": 0.0,
        "duration_s": 0.5
      },
      "xapi_verb": "passed",
      "xapi_description": "L'élève a trouvé la position d'équilibre de la balance."
    },
    {
      "id": "evt_show_pilon_distance",
      "trigger": "pilon.is_dragged == true",
      "action": "set_display_text",
      "target": "pilon",
      "params": {
        "value": "dist_F",
        "unit": "m",
        "label": "dF =",
        "precision": 2,
        "color": "#FFFFFF",
        "background": "#0b0f14"
      },
      "xapi_verb": "experienced",
      "xapi_description": "Affiche la distance du pilon au pivot (dF)."
    },
    {
      "id": "evt_show_equilibrium_feedback",
      "trigger": "abs(pilon.position.x - equilibrium_pos) < 0.01",
      "action": "set_outline_color",
      "target": "fleau",
      "params": {
        "color": [
          0.1,
          1.0,
          0.1
        ],
        "intensity": 2.0
      },
      "xapi_verb": "completed",
      "xapi_description": "L'élève a correctement positionné le pilon pour l'équilibre."
    }
  ],
  "export": {
    "format": "glb",
