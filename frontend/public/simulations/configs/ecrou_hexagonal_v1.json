    },
    {
      "id": "evt_engager_cle",
      "trigger": "cle_plate.is_dragged_onto(ecrou)",
      "action": "set_property",
      "target": "cle_plate",
      "params": {
        "is_engaged": true
      },
      "xapi_verb": "attempted",
      "xapi_description": "L'utilisateur engage la clé sur l'écrou."
    },
    {
      "id": "evt_serrer_ecrou",
      "trigger": "cle_plate.is_engaged == true AND cle_plate.is_rotated",
      "action": "animate_screw",
      "target": "ecrou",
      "params": {
        "axis": [
          0,
          0,
          1
        ],
        "linked_translation_axis": [
          0,
          0,
          -1
        ],
        "pitch": 0.0015
      },
      "xapi_verb": "experienced",
      "xapi_description": "L'utilisateur serre l'écrou sur la vis."
    },
    {
      "id": "evt_serrage_complet",
      "trigger": "ecrou.position.z <= vis_tete.position.z + (vis_tete.scale.z / 2) + (ecrou.scale.z / 2)",
      "action": "set_property",
      "target": "ecrou",
      "params": {
        "is_tight": true
      },
      "xapi_verb": "completed",
      "xapi_description": "Serrage de l'écrou terminé avec succès."
    }
  ],
