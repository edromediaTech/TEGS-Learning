# Configuration d'un noeud TEGS-Edge. Copier en .env.edge (jamais commite) et remplir.

# --- Identite du satellite (cree sur le cloud : POST /api/centers, jeton montre une fois) ---
TEGS_CENTER_ID=CRNS-NORD-EST-01
TEGS_CENTER_NAME="Centre Pilote Fort-Liberte"
TEGS_CLOUD_GATEWAY_URL=https://tegs-backend-746425674533.us-central1.run.app
TEGS_EDGE_API_KEY=tegs_edge_A_REMPLACER

# --- Securite locale : secret des sessions du noeud (generer : openssl rand -hex 32) ---
JWT_SECRET=A_REMPLACER

# --- Reseau et synchro ---
LOCAL_PORT=80
SYNC_INTERVAL_SECONDS=300
